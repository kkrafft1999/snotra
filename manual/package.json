{
  "name": "snotra-manual",
  "private": true,
  "type": "module",
  "description": "User manual for Snotra AI, published at https://docs.snotra-ai.dev",
  "scripts": {
    "sync:icon": "node scripts/sync-icon.mjs",
    "predev": "npm run sync:icon",
    "dev": "astro dev",
    "prebuild": "npm run sync:icon",
    "build": "npm run check:translations && astro build",
    "preview": "astro preview",
    "check:translations": "node scripts/check-translations.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/starlight": "^0.42.5",
    "@fontsource/inter": "^5.3.0",
    "astro": "^7.3.6",
    "sharp": "^0.35.5"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true
  }
}
