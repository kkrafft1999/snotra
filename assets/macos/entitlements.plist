<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements of the main app bundle (#662). The helper apps
  keep the per-helper defaults of @electron/osx-sign, which follow Chromium's.

  - allow-jit: V8 compiles JavaScript at run time; without it the app does
    not start under the hardened runtime.
  - device.audio-input: voice input records from the microphone
    (src/renderer/voice/WhisperRecorder.js).

  Deliberately left out, although the osx-sign default grants them: camera,
  Bluetooth, USB, printing and location. The app uses none of them.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
  </dict>
</plist>
