{
  "name": "snotra",
  "version": "1.16.0",
  "main": "src/main/index.js",
  "productName": "Snotra Agent",
  "scripts": {
    "sync-vendor": "node scripts/sync-renderer-vendor.js",
    "postinstall": "node scripts/sync-renderer-vendor.js",
    "pretest": "node scripts/sync-renderer-vendor.js",
    "test": "node --test \"test/**/*.test.js\"",
    "pretest:e2e": "node scripts/sync-renderer-vendor.js && node e2e/helpers/warm-keychain.mjs",
    "test:e2e": "node --test e2e/*.test.mjs",
    "precoverage": "node scripts/sync-renderer-vendor.js",
    "coverage": "node scripts/coverage.js",
    "start": "npm run sync-vendor && unset ELECTRON_RUN_AS_NODE && electron .",
    "package": "npm run sync-vendor && electron-forge package --arch arm64 --platform darwin",
    "package:win": "npm run sync-vendor && electron-forge package --platform win32 --arch x64",
    "package:linux": "npm run sync-vendor && electron-forge package --platform linux --arch x64",
    "make": "npm run package && node scripts/make-dmg.js",
    "make:linux": "npm run sync-vendor && node scripts/fetch-appimage-runtime.js && electron-forge make --platform linux --arch x64",
    "check-package": "node scripts/check-asar-contents.js"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "name": "Snotra Agent",
        "executableName": "Snotra Agent",
        "appBundleId": "dev.snotra-ai.app",
        "appCategoryType": "public.app-category.productivity",
        "icon": "./icon",
        "asar": {
          "unpack": "**/node_modules/@anthropic-ai/sandbox-runtime/vendor/**"
        },
        "afterComplete": [
          "./scripts/sign-macos.js"
        ],
        "ignore": [
          "^/(?!(src|system-skills|node_modules)(/|$)|package\\.json$|LICENSE$)",
          "/\\.DS_Store$",
          "/node_modules/@anthropic-ai/sandbox-runtime/vendor/srt-win(/|$)"
        ]
      },
      "plugins": [
        {
          "name": "@electron-forge/plugin-fuses",
          "config": {
            "0": false,
            "2": false,
            "3": false,
            "5": true,
            "version": "1"
          }
        }
      ],
      "makers": [
        {
          "name": "@electron-forge/maker-deb",
          "platforms": [
            "linux"
          ],
          "config": {
            "options": {
              "bin": "Snotra Agent",
              "maintainer": "Konrad Krafft <konrad.krafft@gmail.com>",
              "homepage": "https://github.com/kkrafft1999/snotra",
              "description": "Workspace-bewusster KI-Assistent mit Datei-Explorer",
              "genericName": "KI-Assistent",
              "categories": [
                "Utility",
                "Development"
              ],
              "icon": {
                "512x512": "icon.png",
                "scalable": "assets/icon/icon-windows.svg"
              },
              "depends": [
                "bubblewrap",
                "socat",
                "ripgrep"
              ]
            }
          }
        },
        {
          "name": "@reforged/maker-appimage",
          "platforms": [
            "linux"
          ],
          "config": {
            "options": {
              "bin": "Snotra Agent",
              "productName": "Snotra Agent",
              "genericName": "KI-Assistent",
              "categories": [
                "Utility",
                "Development"
              ],
              "icon": "icon.png",
              "compressor": "xz",
              "runtime": "out/appimage-runtime/runtime-x86_64"
            }
          }
        }
      ]
    }
  },
  "keywords": [],
  "author": "Konrad Krafft",
  "license": "Apache-2.0",
  "description": "Snotra Agent – workspace-aware AI assistant on top of a file explorer, extensible with skills and tools.",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.78",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron/asar": "^4.3.1",
    "@electron/fuses": "^2.1.3",
    "@electron/notarize": "^3.1.1",
    "@electron/osx-sign": "^2.7.1",
    "@fontsource/inter": "^5.3.0",
    "@reforged/maker-appimage": "^5.3.1",
    "dompurify": "^3.4.16",
    "electron": "^44.5.1",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "marked": "^18.0.14",
    "pdfjs-dist": "^6.3.289",
    "playwright-core": "^1.63.0",
    "prismjs": "^1.30.0"
  },
  "overrides": {
    "@reforged/maker-appimage": {
      "@electron-forge/maker-base": "^8.0.1"
    }
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true,
    "fs-xattr": true,
    "macos-alias": true
  }
}
