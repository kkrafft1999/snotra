{
  "name": "snotra",
  "version": "1.1.0",
  "main": "src/main/index.js",
  "productName": "Snotra AI",
  "scripts": {
    "sync-vendor": "node scripts/sync-renderer-vendor.js",
    "postinstall": "node scripts/sync-renderer-vendor.js",
    "pretest": "node scripts/sync-renderer-vendor.js",
    "test": "node --test \"test/**/*.test.js\"",
    "start": "npm run sync-vendor && unset ELECTRON_RUN_AS_NODE && electron .",
    "package": "npm run sync-vendor && electron-forge package --arch arm64 --platform darwin",
    "package:win": "npm run sync-vendor && electron-forge package --platform win32 --arch x64",
    "make": "npm run sync-vendor && electron-forge make --arch arm64 --platform darwin"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "name": "Snotra AI",
        "executableName": "Snotra AI",
        "appBundleId": "dev.snotra-ai.app",
        "appCategoryType": "public.app-category.productivity",
        "icon": "./icon",
        "asar": true,
        "ignore": [
          "/\\.venv($|/)"
        ]
      },
      "hooks": {
        "prePackage": "node scripts/sync-renderer-vendor.js"
      },
      "makers": [
        {
          "name": "@electron-forge/maker-dmg",
          "config": {
            "format": "ULFO",
            "name": "Snotra AI"
          }
        },
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "darwin"
          ]
        }
      ]
    }
  },
  "keywords": [],
  "author": "Konrad Krafft",
  "license": "Apache-2.0",
  "description": "Snotra AI – workspace-aware AI assistant on top of a file explorer, extensible with skills and tools.",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "dompurify": "^3.4.11",
    "marked": "^17.0.5",
    "undici": "^7.28.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "electron": "^41.5.0",
    "esbuild": "^0.28.1"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.13",
    "tar": "^7.5.16",
    "lodash": "^4.18.1",
    "picomatch": "^2.3.2",
    "tmp": "^0.2.6"
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true,
    "fs-xattr": true,
    "macos-alias": true
  }
}
