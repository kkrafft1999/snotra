// Type checking over the existing JSDoc (#1004). The app stays plain
// JavaScript without a build step: `tsc` only reads, `noEmit` writes nothing.
// What is checked and why is described in docs/architecture.md, "Plain JS,
// checked by JSDoc".
{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2024",
    "lib": ["es2024"],
    "types": ["node"],
    "skipLibCheck": true,
    // Not `strict` as a whole: `noImplicitAny` is still off, so an
    // unannotated parameter stays `any` instead of failing. Turned on, it
    // reports about 1,900 places, most of them untyped parameters in files the
    // included ones import, which is a typing project of its own (#1098).
    // `strictNullChecks` is on: `null` and `undefined` are values of their
    // own, and a truthiness check narrows a `{ error } | { ok }` union. What
    // is on catches a port and its adapter disagreeing — a missing or extra
    // member, a wrong shape, a wrong argument count — and callbacks that
    // take the wrong parameters.
    "strict": false,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "noImplicitThis": true
  },
  // A deliberate list, not the whole of `src/`: the core, the ports, the
  // contracts and the adapters that implement the ports. Files these import
  // are checked too, since `checkJs` checks every file in the program.
  "include": [
    "src/application/**/*.js",
    "src/main/ports/**/*.js",
    "src/main/adapters/**/*.js",
    "src/main/remote/**/*.js",
    "src/shared/contracts/**/*.js",
    "src/main/services/shell-runner-service.js",
    "src/main/services/python-runner-service.js",
    "src/main/services/tool-policy-store.js",
    "src/main/services/atomic-write.js",
    "src/main/tools/workspace-tool-registry.js",
    "types/**/*.d.ts"
  ]
}
