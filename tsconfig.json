// Type checking over the existing JSDoc (#1004). The app stays plain
// JavaScript without a build step: `tsc` only reads, `noEmit` writes nothing.
// What is checked and why is described in docs/architecture.md, "Plain JS,
// checked by JSDoc".
{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2024",
    "lib": ["es2024"],
    "types": ["node"],
    "skipLibCheck": true,
    // Not `strict` as a whole: `noImplicitAny` is still off, because the last
    // files — the sandbox service and the composition root — are not
    // annotated yet (#1098). Every other file passes with it on.
    // `strictNullChecks` is on: `null` and `undefined` are values of their
    // own, and a truthiness check narrows a `{ error } | { ok }` union. What
    // is on catches a port and its adapter disagreeing — a missing or extra
    // member, a wrong shape, a wrong argument count — and callbacks that
    // take the wrong parameters.
    "strict": false,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "noImplicitThis": true
  },
  // `src/application`, `src/main` and `src/shared` as a whole, except the files
  // listed under `exclude` while they are still untyped (#1098). Files an
  // included one imports are checked too, since `checkJs` checks every file in
  // the program, so `exclude` only keeps a file from being a root of its own.
  "include": [
    "src/application/**/*.js",
    "src/main/**/*.js",
    "src/shared/**/*.js",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "src/main/index.js",
    "src/main/composition/create-application.js"
  ]
}
