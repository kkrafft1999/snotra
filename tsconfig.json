{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2024",
    "lib": [
      "es2024"
    ],
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "strict": false
  },
  "include": [
    "src/application/**/*.js",
    "src/main/ports/**/*.js",
    "src/shared/contracts/**/*.js",
    "types/**/*.d.ts"
  ]
}
